generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  SUPER_ADMIN
  GROUP_ADMIN
  MEMBER
}

enum GroupStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum PlanStatus {
  FREE
  TRIAL
  PAID
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  DEFAULTED
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSING
  CLOSED
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
  WRITTEN_OFF
}

/// What a fine rule or fine is charged against. Contribution fines and
/// loan-interest fines are tracked separately per the group rules.
enum FineTarget {
  CONTRIBUTION
  INTEREST
}

/// Year-end group decision for a member who defaulted.
enum DefaultDecision {
  PENDING
  RETURN_FULL
  RETURN_PARTIAL
  RETURN_NONE
  CARRY_FORWARD
  CUSTOM
}

enum LedgerEntryType {
  CONTRIBUTION
  LOAN_DISBURSEMENT
  PRINCIPAL_REPAYMENT
  INTEREST_PAYMENT
  CONTRIBUTION_FINE
  INTEREST_FINE
  CORRECTION
  REVERSAL
  DISTRIBUTION
}

enum ReceiptType {
  CONTRIBUTION
  LOAN
  REPAYMENT
  INTEREST
  FINE
  DISTRIBUTION
}

enum DistributionBase {
  INTEREST_ONLY
  CORPUS_PLUS_INTEREST
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  name          String
  passwordHash  String?
  isActive      Boolean       @default(true)
  preferredLang String        @default("en")
  role          UserRole      @default(MEMBER)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  memberships   GroupMember[]
  auditLogs     AuditLog[]
  periodLocks   PeriodLock[]
}

model Group {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  platformName     String          @default("BhishiBook")
  status           GroupStatus     @default(ACTIVE)
  planStatus       PlanStatus      @default(FREE)
  defaultLang      String          @default("en")
  currency         String          @default("INR")
  poweredByEnabled Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  members          GroupMember[]
  cycles           Cycle[]
  receipts         Receipt[]
  ledgerEntries    LedgerEntry[]
  auditLogs        AuditLog[]
  fineRules        FineRule[]
  periodLocks      PeriodLock[]
  receiptCounter   ReceiptCounter?
}

model GroupMember {
  id               String              @id @default(uuid()) @db.Uuid
  groupId          String              @db.Uuid
  userId           String?             @db.Uuid
  displayName      String
  displayNameMr    String?
  phone            String?
  email            String?
  shareCount       Int                 @default(1)
  monthlyHafta     Decimal             @db.Decimal(12, 2)
  status           MembershipStatus    @default(ACTIVE)
  defaultDecision  DefaultDecision     @default(PENDING)
  defaultDecidedAt DateTime?
  defaultNote      String?
  joinedAt         DateTime            @default(now())
  group            Group               @relation(fields: [groupId], references: [id])
  user             User?               @relation(fields: [userId], references: [id])
  contributions    Contribution[]
  loans            Loan[]
  repayments       LoanRepayment[]
  interestDues     InterestDue[]
  fines            Fine[]
  receipts         Receipt[]
  distributions    FinalDistribution[]
  loanApplications LoanApplication[]   @relation("MemberLoanApplications")
  guaranteedLoans  LoanGuarantor[]     @relation("MemberGuarantees")
  loanVotes        LoanApplicationVote[] @relation("MemberLoanVotes")

  @@index([groupId])
  @@index([userId])
}

model Cycle {
  id                    String              @id @default(uuid()) @db.Uuid
  groupId               String              @db.Uuid
  name                  String
  startsOn              DateTime
  endsOn                DateTime
  status                CycleStatus         @default(DRAFT)
  contributionDueDay    Int                 @default(10)
  monthlyInterestRate   Decimal             @default(3.00) @db.Decimal(5, 2)
  maxRepaymentMonths    Int                 @default(6)
  maxLoanCorpusMultiple Decimal             @default(2.00) @db.Decimal(5, 2)
  distributionBase      DistributionBase    @default(INTEREST_ONLY)
  distributeFines       Boolean             @default(true)
  closedAt              DateTime?
  group                 Group               @relation(fields: [groupId], references: [id])
  contributions         Contribution[]
  loans                 Loan[]
  interestDues          InterestDue[]
  fines                 Fine[]
  ledgerEntries         LedgerEntry[]
  receipts              Receipt[]
  periodLocks           PeriodLock[]
  distributions         FinalDistribution[]
  loanApplications      LoanApplication[]

  @@index([groupId])
}

model Contribution {
  id         String      @id @default(uuid()) @db.Uuid
  cycleId    String      @db.Uuid
  memberId   String      @db.Uuid
  month      Int
  year       Int
  amountDue  Decimal     @db.Decimal(12, 2)
  amountPaid Decimal     @default(0) @db.Decimal(12, 2)
  paidOn     DateTime?
  notes      String?
  cycle      Cycle       @relation(fields: [cycleId], references: [id])
  member     GroupMember @relation(fields: [memberId], references: [id])
  fines      Fine[]
  receipts   Receipt[]

  @@unique([cycleId, memberId, month, year])
  @@index([cycleId, year, month])
  @@index([memberId])
}

model Loan {
  id              String          @id @default(uuid()) @db.Uuid
  cycleId         String          @db.Uuid
  memberId        String          @db.Uuid
  principal       Decimal         @db.Decimal(12, 2)
  disbursedOn     DateTime
  dueOn           DateTime
  interestRate    Decimal         @db.Decimal(5, 2)
  status          LoanStatus      @default(ACTIVE)
  principalClosed Boolean         @default(false)
  closedOn        DateTime?
  notes           String?
  cycle           Cycle           @relation(fields: [cycleId], references: [id])
  member          GroupMember     @relation(fields: [memberId], references: [id])
  repayments      LoanRepayment[]
  interestDues    InterestDue[]
  fines           Fine[]
  receipts        Receipt[]
  application     LoanApplication? @relation("DisbursedLoanApplication")

  @@index([cycleId])
  @@index([memberId])
  @@index([status])
}

/// One row per loan per month: the interest the borrower must pay inside the
/// 1st-10th window. Gives the interest fine something to attach to, exactly
/// like Contribution does for the monthly hafta.
model InterestDue {
  id         String      @id @default(uuid()) @db.Uuid
  cycleId    String      @db.Uuid
  loanId     String      @db.Uuid
  memberId   String      @db.Uuid
  month      Int
  year       Int
  amountDue  Decimal     @db.Decimal(12, 2)
  amountPaid Decimal     @default(0) @db.Decimal(12, 2)
  paidOn     DateTime?
  notes      String?
  cycle      Cycle       @relation(fields: [cycleId], references: [id])
  loan       Loan        @relation(fields: [loanId], references: [id])
  member     GroupMember @relation(fields: [memberId], references: [id])
  fines      Fine[]

  @@unique([loanId, month, year])
  @@index([cycleId, year, month])
  @@index([memberId])
}

model LoanRepayment {
  id              String      @id @default(uuid()) @db.Uuid
  loanId          String      @db.Uuid
  memberId        String      @db.Uuid
  paidOn          DateTime
  principalAmount Decimal     @default(0) @db.Decimal(12, 2)
  interestAmount  Decimal     @default(0) @db.Decimal(12, 2)
  fineAmount      Decimal     @default(0) @db.Decimal(12, 2)
  notes           String?
  loan            Loan        @relation(fields: [loanId], references: [id])
  member          GroupMember @relation(fields: [memberId], references: [id])
  fines           Fine[]
  receipts        Receipt[]

  @@index([loanId])
  @@index([memberId])
}

model FineRule {
  id             String     @id @default(uuid()) @db.Uuid
  groupId        String     @db.Uuid
  name           String
  appliesTo      FineTarget
  fixedPerDay    Decimal    @db.Decimal(12, 2)
  /// Days after the due day before the per-day fine starts. 0 means the fine
  /// starts the day after the due day (the 11th when the due day is the 10th).
  graceDays      Int        @default(0)
  /// Upper bound on billable late days. 0 means uncapped.
  maxFineDays    Int        @default(0)
  distributeFine Boolean    @default(true)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  group          Group      @relation(fields: [groupId], references: [id])

  @@unique([groupId, appliesTo])
  @@index([groupId])
}

model Fine {
  id             String         @id @default(uuid()) @db.Uuid
  cycleId        String         @db.Uuid
  memberId       String         @db.Uuid
  contributionId String?        @db.Uuid
  interestDueId  String?        @db.Uuid
  loanId         String?        @db.Uuid
  repaymentId    String?        @db.Uuid
  fineType       FineTarget
  month          Int
  year           Int
  daysLate       Int
  amount         Decimal        @db.Decimal(12, 2)
  amountPaid     Decimal        @default(0) @db.Decimal(12, 2)
  waivedAmount   Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  cycle          Cycle          @relation(fields: [cycleId], references: [id])
  member         GroupMember    @relation(fields: [memberId], references: [id])
  contribution   Contribution?  @relation(fields: [contributionId], references: [id])
  interestDue    InterestDue?   @relation(fields: [interestDueId], references: [id])
  loan           Loan?          @relation(fields: [loanId], references: [id])
  repayment      LoanRepayment? @relation(fields: [repaymentId], references: [id])
  receipts       Receipt[]

  @@unique([contributionId])
  @@unique([interestDueId])
  @@index([cycleId])
  @@index([memberId])
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  groupId       String          @db.Uuid
  cycleId       String?         @db.Uuid
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  entryDate     DateTime
  description   String
  referenceType String?
  referenceId   String?         @db.Uuid
  reversalOfId  String?         @db.Uuid
  createdAt     DateTime        @default(now())
  group         Group           @relation(fields: [groupId], references: [id])
  cycle         Cycle?          @relation(fields: [cycleId], references: [id])
  reversalOf    LedgerEntry?    @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversals     LedgerEntry[]   @relation("LedgerReversal")

  @@index([groupId])
  @@index([cycleId])
  @@index([referenceId])
}

/// Per-group running receipt number. Bumped inside the same transaction that
/// writes the receipt so two concurrent admins cannot mint the same number.
model ReceiptCounter {
  groupId    String @id @db.Uuid
  nextNumber Int    @default(1)
  group      Group  @relation(fields: [groupId], references: [id])
}

model Receipt {
  id             String             @id @default(uuid()) @db.Uuid
  groupId        String             @db.Uuid
  cycleId        String?            @db.Uuid
  memberId       String?            @db.Uuid
  contributionId String?            @db.Uuid
  loanId         String?            @db.Uuid
  repaymentId    String?            @db.Uuid
  fineId         String?            @db.Uuid
  distributionId String?            @db.Uuid
  receiptNo      String
  receiptType    ReceiptType
  amount         Decimal            @db.Decimal(12, 2)
  issuedAt       DateTime           @default(now())
  whatsappText   String?
  pdfUrl         String?
  group          Group              @relation(fields: [groupId], references: [id])
  cycle          Cycle?             @relation(fields: [cycleId], references: [id])
  member         GroupMember?       @relation(fields: [memberId], references: [id])
  contribution   Contribution?      @relation(fields: [contributionId], references: [id])
  loan           Loan?              @relation(fields: [loanId], references: [id])
  repayment      LoanRepayment?     @relation(fields: [repaymentId], references: [id])
  fine           Fine?              @relation(fields: [fineId], references: [id])
  distribution   FinalDistribution? @relation(fields: [distributionId], references: [id])

  @@unique([groupId, receiptNo])
  @@index([memberId])
  @@index([cycleId])
}

/// A reviewed month, locked so historical figures cannot drift.
model PeriodLock {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  cycleId    String   @db.Uuid
  month      Int
  year       Int
  note       String?
  lockedAt   DateTime @default(now())
  lockedById String?  @db.Uuid
  group      Group    @relation(fields: [groupId], references: [id])
  cycle      Cycle    @relation(fields: [cycleId], references: [id])
  lockedBy   User?    @relation(fields: [lockedById], references: [id])

  @@unique([cycleId, month, year])
  @@index([groupId])
}

/// Per-member settlement written when a cycle closes.
model FinalDistribution {
  id                String      @id @default(uuid()) @db.Uuid
  cycleId           String      @db.Uuid
  memberId          String      @db.Uuid
  shareCount        Int
  corpusContributed Decimal     @db.Decimal(12, 2)
  interestShare     Decimal     @default(0) @db.Decimal(12, 2)
  fineShare         Decimal     @default(0) @db.Decimal(12, 2)
  corpusReturned    Decimal     @default(0) @db.Decimal(12, 2)
  deductions        Decimal     @default(0) @db.Decimal(12, 2)
  payoutAmount      Decimal     @db.Decimal(12, 2)
  notes             String?
  paidOn            DateTime?
  createdAt         DateTime    @default(now())
  cycle             Cycle       @relation(fields: [cycleId], references: [id])
  member            GroupMember @relation(fields: [memberId], references: [id])
  receipts          Receipt[]

  @@unique([cycleId, memberId])
  @@index([cycleId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())
  group       Group?   @relation(fields: [groupId], references: [id])
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([groupId])
  @@index([actorUserId])
  @@index([createdAt])
}

enum LoanApplicationStatus {
  PENDING_APPROVAL
  READY_FOR_DISBURSEMENT
  DISBURSED
  REJECTED
  CANCELLED
}

enum GuarantorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum VoteChoice {
  APPROVE
  REJECT
}

model LoanApplication {
  id              String                @id @default(uuid()) @db.Uuid
  cycleId         String                @db.Uuid
  applicantId     String                @db.Uuid
  requestedAmount Decimal               @db.Decimal(12, 2)
  termMonths      Int                   @default(6)
  purpose         String?
  status          LoanApplicationStatus @default(PENDING_APPROVAL)
  appliedAt       DateTime              @default(now())
  disbursedLoanId String?               @unique @db.Uuid

  cycle           Cycle                 @relation(fields: [cycleId], references: [id])
  applicant       GroupMember           @relation("MemberLoanApplications", fields: [applicantId], references: [id])
  disbursedLoan   Loan?                 @relation("DisbursedLoanApplication", fields: [disbursedLoanId], references: [id])
  guarantors      LoanGuarantor[]
  votes           LoanApplicationVote[]

  @@index([cycleId])
  @@index([applicantId])
  @@index([status])
}

model LoanGuarantor {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @db.Uuid
  memberId      String          @db.Uuid
  status        GuarantorStatus @default(PENDING)
  respondedAt   DateTime?

  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  member        GroupMember     @relation("MemberGuarantees", fields: [memberId], references: [id])

  @@unique([applicationId, memberId])
  @@index([applicationId])
  @@index([memberId])
}

model LoanApplicationVote {
  id            String     @id @default(uuid()) @db.Uuid
  applicationId String     @db.Uuid
  memberId      String     @db.Uuid
  decision      VoteChoice
  votedAt       DateTime   @default(now())

  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  member        GroupMember     @relation("MemberLoanVotes", fields: [memberId], references: [id])

  @@unique([applicationId, memberId])
  @@index([applicationId])
  @@index([memberId])
}

